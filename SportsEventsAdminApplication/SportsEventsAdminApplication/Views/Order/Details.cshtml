@{
}
@model SportsEventsAdminApplication.Models.Order
<div class="container">
    <div>
        <p>Order for @Model.Owner.FirstName</p>
    </div>

    @for(int i=0;i<Model.TicketsInOrder.Count(); i++)
    {
        var item = Model.TicketsInOrder.ElementAt(i).Ticket;
        if(i % 3 == 0)
        {
            @:<div class="row">
        }
        <div class="col-3 m-4">

            <div class="card" style="width: 18rem; height: 35rem">
               <h5 class="card-title">@item.Tribina</h5>
                <div class="card-body">
                    <h5 class="card-title">@item.CreatedBy</h5>
                    <p class="card-text">@item.Match</p>
                    <h6>Price: @item.Price</h6>
                </div>

            </div>
        </div>

        if(i % 3 == 2)
        {
            @:</div>
        }
    }
</div>